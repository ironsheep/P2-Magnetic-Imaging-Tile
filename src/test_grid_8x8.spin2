''   Updated.... Oct 2025
''
'' =================================================================================================

CON ' ---- Clock Setup ----
  _clkfreq = 250_000_000

  ' Grid configuration
  GRID_SIZE         = 8                                ' 8x8 sensor grid
  SENSORS_PER_FRAME = GRID_SIZE * GRID_SIZE            ' 64 cells per frame

  ' Test value ranges and timing
  GRADIENT_STEP     = 16                               ' Per-cell gradient step
  GRADIENT_MAX      = (SENSORS_PER_FRAME - 1) * GRADIENT_STEP ' 1008 = top of linear gradient
  HOT_VAL           = 1000                             ' "Hot" cell value
  COLD_VAL          = 0                                ' "Cold" cell value
  CENTER_RANGE      = 1000                             ' Center-spot pattern peak
  CENTER_FALLOFF    = 50                               ' Per-r^2 falloff weight
  CENTER_OFFSET     = 3                                ' Center coordinate (3.5 rounded down)
  BIPOLAR_NEG       = -500                             ' South pole intensity
  BIPOLAR_POS       = 500                              ' North pole intensity
  BIPOLAR_HALF_COL  = GRID_SIZE / 2                    ' Column split for bipolar pattern
  PATTERN_HOLD_MS   = 3000                             ' Initial pattern display time
  CYCLE_HOLD_MS     = 2000                             ' Cycle pattern display time

OBJ ' ---- Subsystem Objects ----
  oled : "isp_oled_driver"

VAR ' ---- Test State ----
  long sensor_values[SENSORS_PER_FRAME]  ' 8x8 array of sensor readings

PUB main() | idx, row, col
'' Test 8x8 grid drawing on the OLED with several synthetic field patterns.
''

' Local Variables:
' @local idx - Linear cell index into the 8x8 grid
' @local row - Row coordinate (0..7)
' @local col - Column coordinate (0..7)

  debug("Test Grid 8x8: Starting...", 13, 10)

  ' Initialize OLED
  if not oled.start(0)
    debug("OLED initialization failed!", 13, 10)
  else
    debug("OLED initialized successfully", 13, 10)

    ' Create test pattern 1: Gradient from blue to red
    debug("Pattern 1: Linear gradient (blue to red)", 13, 10)
    repeat idx from 0 to SENSORS_PER_FRAME - 1
      sensor_values[idx] := idx * GRADIENT_STEP  ' Values 0-1008

    oled.draw_grid_8x8(@sensor_values, 0, GRADIENT_MAX)
    waitms(PATTERN_HOLD_MS)

    ' Create test pattern 2: Checkerboard (hot/cold)
    debug("Pattern 2: Checkerboard (hot/cold)", 13, 10)
    repeat row from 0 to GRID_SIZE - 1
      repeat col from 0 to GRID_SIZE - 1
        idx := row * GRID_SIZE + col
        if ((row + col) & 1)
          sensor_values[idx] := HOT_VAL   ' Hot (red)
        else
          sensor_values[idx] := COLD_VAL  ' Cold (blue)

    oled.draw_grid_8x8(@sensor_values, COLD_VAL, HOT_VAL)
    waitms(PATTERN_HOLD_MS)

    ' Create test pattern 3: Center hot spot
    debug("Pattern 3: Center hot spot", 13, 10)
    repeat row from 0 to GRID_SIZE - 1
      repeat col from 0 to GRID_SIZE - 1
        idx := row * GRID_SIZE + col
        ' Distance from center (3.5, 3.5)
        sensor_values[idx] := CENTER_RANGE - ((row - CENTER_OFFSET) * (row - CENTER_OFFSET) + (col - CENTER_OFFSET) * (col - CENTER_OFFSET)) * CENTER_FALLOFF

    oled.draw_grid_8x8(@sensor_values, 0, CENTER_RANGE)
    waitms(PATTERN_HOLD_MS)

    ' Create test pattern 4: Bipolar (north/south poles)
    debug("Pattern 4: Bipolar field (north/south)", 13, 10)
    repeat row from 0 to GRID_SIZE - 1
      repeat col from 0 to GRID_SIZE - 1
        idx := row * GRID_SIZE + col
        if col < BIPOLAR_HALF_COL
          sensor_values[idx] := BIPOLAR_NEG  ' South pole (blue)
        else
          sensor_values[idx] := BIPOLAR_POS  ' North pole (red)

    oled.draw_grid_8x8(@sensor_values, BIPOLAR_NEG, BIPOLAR_POS)
    waitms(PATTERN_HOLD_MS)

    debug("Test complete - display will cycle patterns", 13, 10)

    ' Cycle through patterns continuously
    repeat
      ' Pattern 1
      repeat idx from 0 to SENSORS_PER_FRAME - 1
        sensor_values[idx] := idx * GRADIENT_STEP
      oled.draw_grid_8x8(@sensor_values, 0, GRADIENT_MAX)
      waitms(CYCLE_HOLD_MS)

      ' Pattern 2
      repeat row from 0 to GRID_SIZE - 1
        repeat col from 0 to GRID_SIZE - 1
          idx := row * GRID_SIZE + col
          if ((row + col) & 1)
            sensor_values[idx] := HOT_VAL
          else
            sensor_values[idx] := COLD_VAL
      oled.draw_grid_8x8(@sensor_values, COLD_VAL, HOT_VAL)
      waitms(CYCLE_HOLD_MS)

      ' Pattern 3
      repeat row from 0 to GRID_SIZE - 1
        repeat col from 0 to GRID_SIZE - 1
          idx := row * GRID_SIZE + col
          sensor_values[idx] := CENTER_RANGE - ((row - CENTER_OFFSET) * (row - CENTER_OFFSET) + (col - CENTER_OFFSET) * (col - CENTER_OFFSET)) * CENTER_FALLOFF
      oled.draw_grid_8x8(@sensor_values, 0, CENTER_RANGE)
      waitms(CYCLE_HOLD_MS)

      ' Pattern 4
      repeat row from 0 to GRID_SIZE - 1
        repeat col from 0 to GRID_SIZE - 1
          idx := row * GRID_SIZE + col
          if col < BIPOLAR_HALF_COL
            sensor_values[idx] := BIPOLAR_NEG
          else
            sensor_values[idx] := BIPOLAR_POS
      oled.draw_grid_8x8(@sensor_values, BIPOLAR_NEG, BIPOLAR_POS)
      waitms(CYCLE_HOLD_MS)
