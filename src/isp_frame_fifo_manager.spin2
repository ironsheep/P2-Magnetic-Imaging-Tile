'' =================================================================================================
''
''   File....... isp_frame_fifo_manager.spin2
''   Purpose.... Multi-FIFO frame pool manager with zero-copy architecture for sensor/HDMI/OLED routing
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2025 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2025
''   Updated.... Dec 2025
''
'' =================================================================================================
''
'' Zero-copy architecture with three independent FIFOs sharing a common frame pool.
''
'' FIFOs:
''   - FIFO_SENSOR: Sensor -> Frame Processor
''   - FIFO_HDMI:   Frame Processor -> HDMI Display Engine
''   - FIFO_OLED:   Frame Processor -> OLED Manager

CON ' ---- FIFO Public API ----
  {Spin2_Doc_CON}
  ' FIFO IDs
  FIFO_SENSOR = 0
  FIFO_HDMI   = 1
  FIFO_OLED   = 2

  ' Frame configuration
  FRAME_SIZE  = 128         ' 64 sensors x 2 bytes each
  MAX_FRAMES  = 32          ' Total frames in pool
  FIFO_DEPTH  = 16          ' Max entries per FIFO

  ' Return codes
  SUCCESS     = 0
  ERR_FULL    = -1
  ERR_EMPTY   = -2
  ERR_INVALID = -3

DAT ' ---- Singleton Shared State ----
  ' Singleton shared state - DAT section is shared across ALL OBJ instances
  ' This enables zero-copy frame sharing across all subsystems

  ' Frame pool - all frames live here
  framePool       byte  0[MAX_FRAMES * FRAME_SIZE]

  ' Free frame tracking
  freeList        long  0[MAX_FRAMES]
  freeHead        long  0
  freeTail        long  0
  freeCount       long  0

  ' FIFO structures - just hold pointers
  sensorFIFO      long  0[FIFO_DEPTH]
  sensorHead      long  0
  sensorTail      long  0
  sensorCount     long  0

  hdmiFIFO        long  0[FIFO_DEPTH]
  hdmiHead        long  0
  hdmiTail        long  0
  hdmiCount       long  0

  oledFIFO        long  0[FIFO_DEPTH]
  oledHead        long  0
  oledTail        long  0
  oledCount       long  0

  ' Lock for atomic operations
  lock            long  -1  ' -1 = uninitialized

  ' Consumer COG registration for event-driven wake-ups
  ' -1 = no consumer registered, 0-7 = registered COG ID
  sensorConsumerCog   long  -1
  hdmiConsumerCog     long  -1
  oledConsumerCog     long  -1

PUB null()
'' Not a top-level object.
''

PUB start() : ok | i
'' Initialize the frame pool and all FIFOs.
''
'' @returns ok - TRUE on successful initialization

' Local Variables:
' @local i - Frame index used when seeding the free list

  debug("FIFO: Acquiring lock...", 13, 10)
  lock := locknew()
  debug("FIFO: Lock acquired: ", sdec(lock), 13, 10)

  ' CRITICAL: Explicitly zero ALL FIFO arrays to prevent garbage pointer issues
  ' DAT section initialization may not reliably zero arrays
  debug("FIFO: Zeroing FIFO arrays...", 13, 10)
  longfill(@sensorFIFO, 0, FIFO_DEPTH)
  longfill(@hdmiFIFO, 0, FIFO_DEPTH)
  longfill(@oledFIFO, 0, FIFO_DEPTH)
  longfill(@freeList, 0, MAX_FRAMES)

  ' Initialize free list with all frames
  debug("FIFO: Initializing ", udec(MAX_FRAMES), " frames...", 13, 10)
  repeat i from 0 to MAX_FRAMES-1
    LONG[@freeList][i] := @framePool + (i * FRAME_SIZE)

  freeHead := 0
  freeTail := MAX_FRAMES - 1  ' CORRECT: Knuth's algorithm with count (full queue, next enqueue wraps to 0)
  freeCount := MAX_FRAMES

  debug("FIFO: freeCount = ", udec(freeCount), ", freeHead = ", udec(freeHead), ", freeTail = ", udec(freeTail), 13, 10)

  ' Initialize all FIFOs as empty
  sensorHead := sensorTail := sensorCount := 0
  hdmiHead := hdmiTail := hdmiCount := 0
  oledHead := oledTail := oledCount := 0

  ' Initialize consumer registrations (no consumers yet)
  sensorConsumerCog := -1
  hdmiConsumerCog := -1
  oledConsumerCog := -1

  debug("FIFO: Initialization complete", 13, 10)

  ' Debug: Print addresses of FIFO data structures for correlation with corruption values
  debug("FIFO ADDRESSES:", 13, 10)
  debug("  framePool:   ", uhex_long(@framePool), 13, 10)
  debug("  freeList:    ", uhex_long(@freeList), 13, 10)
  debug("  freeHead:    ", uhex_long(@freeHead), 13, 10)
  debug("  sensorFIFO:  ", uhex_long(@sensorFIFO), 13, 10)
  debug("  sensorHead:  ", uhex_long(@sensorHead), 13, 10)
  debug("  sensorTail:  ", uhex_long(@sensorTail), 13, 10)
  debug("  sensorCount: ", uhex_long(@sensorCount), 13, 10)
  debug("  hdmiFIFO:    ", uhex_long(@hdmiFIFO), 13, 10)
  debug("  hdmiHead:    ", uhex_long(@hdmiHead), 13, 10)
  debug("  oledFIFO:    ", uhex_long(@oledFIFO), 13, 10)
  debug("  oledHead:    ", uhex_long(@oledHead), 13, 10)
  debug("  lock:        ", uhex_long(@lock), 13, 10)

  ok := TRUE

PUB stop()
'' Clean shutdown - release the lock held by the FIFO manager.
''

  if lock >= 0
    lockrel(lock)
    lock := -1

PUB registerConsumer(fifoID, consumerCogID)
'' Register a consumer COG for event-driven wake-ups on the given FIFO.
''
'' @param fifoID - Frame FIFO identifier (FIFO_SENSOR/FIFO_HDMI/FIFO_OLED)
'' @param consumerCogID - Cog identifier (0-7) of the consumer

  case fifoID
    FIFO_SENSOR: sensorConsumerCog := consumerCogID
    FIFO_HDMI:   hdmiConsumerCog := consumerCogID
    FIFO_OLED:   oledConsumerCog := consumerCogID

  debug("FIFO: Registered COG ", udec(consumerCogID), " as consumer for FIFO ", udec(fifoID), 13, 10)

PUB getNextFrame() : framePtr | timeout, poolStart, poolEnd
'' Get the next available frame from the pool, blocking up to ~1 second.
''
'' @returns framePtr - Hub pointer to the frame buffer, or 0 on timeout/corruption

' Local Variables:
' @local timeout - Millisecond-scale wait counter
' @local poolStart - Lowest valid frame-pool hub address
' @local poolEnd - Exclusive upper bound of the frame-pool hub region

  ' Calculate valid frame pool address range for validation
  poolStart := @framePool
  poolEnd := @framePool + (MAX_FRAMES * FRAME_SIZE)

  framePtr := 0  ' Default: no frame (corruption or timeout)
  timeout := 0
  repeat
    repeat until locktry(lock)
      ' Spin waiting for lock

    if freeCount > 0
      ' CRITICAL: Bounds check before array access
      if freeHead >= MAX_FRAMES
        debug("FIFO FATAL: freeHead=", udec(freeHead), " CORRUPTED! Resetting pool.", 13, 10)
        freeHead := 0
        lockrel(lock)
        framePtr := 0
        quit
      ' Get frame from free list
      framePtr := LONG[@freeList][freeHead]
      ' CRITICAL: Validate pointer is within frame pool range
      if framePtr < poolStart or framePtr >= poolEnd
        debug("FIFO FATAL: freeList[", udec(freeHead), "] = ", uhex_long(framePtr), " INVALID! Expected ", uhex_long(poolStart), "-", uhex_long(poolEnd), 13, 10)
        debug("  freeList addr=", uhex_long(@freeList + (freeHead << 2)), 13, 10)
        freeHead := (freeHead + 1) // MAX_FRAMES
        freeCount--
        lockrel(lock)
        framePtr := 0  ' Return 0 instead of garbage pointer
        quit
      freeHead := (freeHead + 1) // MAX_FRAMES
      freeCount--
      lockrel(lock)
      quit  ' Got valid frame, exit loop

    lockrel(lock)

    ' No frames available, wait a bit
    waitms(1)
    if ++timeout > 1000
      framePtr := 0  ' Timeout after 1 second
      quit

PUB commitFrame(fifoID, framePtr) : status | poolStart, poolEnd, consumerCog
'' Commit a frame to the specified FIFO and wake a registered consumer COG.
''
'' @param fifoID - Frame FIFO identifier (FIFO_SENSOR/FIFO_HDMI/FIFO_OLED)
'' @param framePtr - Hub pointer to the frame buffer
'' @returns status - SUCCESS, ERR_FULL, or ERR_INVALID

' Local Variables:
' @local poolStart - Lowest valid frame-pool hub address
' @local poolEnd - Exclusive upper bound of the frame-pool hub region
' @local consumerCog - Cog identifier (0-7) of the registered consumer (or -1)

  ' Calculate valid frame pool address range for validation
  poolStart := @framePool
  poolEnd := @framePool + (MAX_FRAMES * FRAME_SIZE)

  ' CRITICAL: Validate frame pointer BEFORE acquiring lock
  if framePtr < poolStart or framePtr >= poolEnd
    debug("FIFO FATAL: commitFrame() ptr=", uhex_long(framePtr), " INVALID! Expected ", uhex_long(poolStart), "-", uhex_long(poolEnd), 13, 10)
    status := ERR_INVALID
  else
    consumerCog := -1  ' No notification by default

    repeat until locktry(lock)
      ' Spin waiting for lock

    case fifoID
      FIFO_SENSOR:
        if sensorCount < FIFO_DEPTH
          ' CRITICAL: Bounds check tail index before write to prevent memory corruption
          if sensorTail >= FIFO_DEPTH
            debug("FIFO FATAL: sensorTail=", udec(sensorTail), " OVERFLOW! Resetting.", 13, 10)
            sensorTail := 0  ' Emergency reset
          LONG[@sensorFIFO][sensorTail] := framePtr
          sensorTail := (sensorTail + 1) // FIFO_DEPTH
          sensorCount++
          consumerCog := sensorConsumerCog
          status := SUCCESS
        else
          status := ERR_FULL

      FIFO_HDMI:
        if hdmiCount < FIFO_DEPTH
          ' CRITICAL: Bounds check tail index before write to prevent memory corruption
          if hdmiTail >= FIFO_DEPTH
            debug("FIFO FATAL: hdmiTail=", udec(hdmiTail), " OVERFLOW! Resetting.", 13, 10)
            hdmiTail := 0  ' Emergency reset
          LONG[@hdmiFIFO][hdmiTail] := framePtr
          hdmiTail := (hdmiTail + 1) // FIFO_DEPTH
          hdmiCount++
          consumerCog := hdmiConsumerCog
          status := SUCCESS
        else
          status := ERR_FULL

      FIFO_OLED:
        if oledCount < FIFO_DEPTH
          ' CRITICAL: Bounds check tail index before write to prevent memory corruption
          if oledTail >= FIFO_DEPTH
            debug("FIFO FATAL: oledTail=", udec(oledTail), " OVERFLOW! Resetting.", 13, 10)
            oledTail := 0  ' Emergency reset
          LONG[@oledFIFO][oledTail] := framePtr
          oledTail := (oledTail + 1) // FIFO_DEPTH
          oledCount++
          consumerCog := oledConsumerCog
          status := SUCCESS
        else
          status := ERR_FULL

      other:
        status := ERR_INVALID

    lockrel(lock)

    ' Notify consumer COG if registered (AFTER releasing lock)
    if consumerCog >= 0 and status == SUCCESS
      notifyConsumer(consumerCog)

PUB dequeue(fifoID) : framePtr | timeout, poolStart, poolEnd, bDone
'' Dequeue a frame from the specified FIFO, blocking up to ~1 second.
''
'' @param fifoID - Frame FIFO identifier (FIFO_SENSOR/FIFO_HDMI/FIFO_OLED)
'' @returns framePtr - Hub pointer to the frame buffer, or 0 on timeout/corruption

' Local Variables:
' @local timeout - Millisecond-scale wait counter
' @local poolStart - Lowest valid frame-pool hub address
' @local poolEnd - Exclusive upper bound of the frame-pool hub region
' @local bDone - TRUE once the dequeue loop should exit

  ' Calculate valid frame pool address range for validation
  poolStart := @framePool
  poolEnd := @framePool + (MAX_FRAMES * FRAME_SIZE)

  framePtr := 0
  bDone := FALSE
  timeout := 0
  repeat
    repeat until locktry(lock)
      ' Spin waiting for lock

    case fifoID
      FIFO_SENSOR:
        if sensorCount > 0
          ' CRITICAL: Bounds check head index before read to prevent wild memory access
          if sensorHead >= FIFO_DEPTH
            debug("FIFO FATAL: sensorHead=", udec(sensorHead), " CORRUPTED! Resetting FIFO.", 13, 10)
            debug("  sensorHead addr=", uhex_long(@sensorHead), " value=", uhex_long(sensorHead), 13, 10)
            sensorHead := 0
            sensorTail := 0
            sensorCount := 0
            lockrel(lock)
            framePtr := 0
            bDone := TRUE
          else
            framePtr := LONG[@sensorFIFO][sensorHead]
            ' CRITICAL: Validate pointer before returning
            if framePtr < poolStart or framePtr >= poolEnd
              debug("FIFO ERROR: Sensor dequeue invalid ptr=", uhex_long(framePtr), " head=", udec(sensorHead), " count=", udec(sensorCount), 13, 10)
              sensorHead := (sensorHead + 1) // FIFO_DEPTH
              sensorCount--
              lockrel(lock)
              framePtr := 0  ' Return 0 instead of garbage
              bDone := TRUE
            else
              sensorHead := (sensorHead + 1) // FIFO_DEPTH
              sensorCount--
              lockrel(lock)
              bDone := TRUE

      FIFO_HDMI:
        if hdmiCount > 0
          ' CRITICAL: Bounds check head index before read to prevent wild memory access
          if hdmiHead >= FIFO_DEPTH
            debug("FIFO FATAL: hdmiHead=", udec(hdmiHead), " CORRUPTED! Resetting FIFO.", 13, 10)
            hdmiHead := 0
            hdmiTail := 0
            hdmiCount := 0
            lockrel(lock)
            framePtr := 0
            bDone := TRUE
          else
            framePtr := LONG[@hdmiFIFO][hdmiHead]
            ' CRITICAL: Validate pointer before returning
            if framePtr < poolStart or framePtr >= poolEnd
              debug("FIFO ERROR: HDMI dequeue invalid ptr=", uhex_long(framePtr), " head=", udec(hdmiHead), " count=", udec(hdmiCount), 13, 10)
              hdmiHead := (hdmiHead + 1) // FIFO_DEPTH
              hdmiCount--
              lockrel(lock)
              framePtr := 0  ' Return 0 instead of garbage
              bDone := TRUE
            else
              hdmiHead := (hdmiHead + 1) // FIFO_DEPTH
              hdmiCount--
              lockrel(lock)
              bDone := TRUE

      FIFO_OLED:
        if oledCount > 0
          ' CRITICAL: Bounds check head index before read to prevent wild memory access
          if oledHead >= FIFO_DEPTH
            debug("FIFO FATAL: oledHead=", udec(oledHead), " CORRUPTED! Resetting FIFO.", 13, 10)
            oledHead := 0
            oledTail := 0
            oledCount := 0
            lockrel(lock)
            framePtr := 0
            bDone := TRUE
          else
            framePtr := LONG[@oledFIFO][oledHead]
            ' CRITICAL: Validate pointer before returning
            if framePtr < poolStart or framePtr >= poolEnd
              debug("FIFO ERROR: OLED dequeue invalid ptr=", uhex_long(framePtr), " head=", udec(oledHead), " count=", udec(oledCount), 13, 10)
              oledHead := (oledHead + 1) // FIFO_DEPTH
              oledCount--
              lockrel(lock)
              framePtr := 0  ' Return 0 instead of garbage
              bDone := TRUE
            else
              oledHead := (oledHead + 1) // FIFO_DEPTH
              oledCount--
              lockrel(lock)
              bDone := TRUE

      other:
        lockrel(lock)
        framePtr := 0
        bDone := TRUE

    if bDone
      quit

    lockrel(lock)

    ' No frames available, wait
    waitms(1)
    if ++timeout > 1000
      framePtr := 0  ' Timeout
      quit

PUB dequeueEventDriven(fifoID) : framePtr | poolStart, poolEnd, bHandled
'' Event-driven dequeue that blocks on WAITATN until a producer signals data.
''
'' @param fifoID - Frame FIFO identifier (FIFO_SENSOR/FIFO_HDMI/FIFO_OLED)
'' @returns framePtr - Hub pointer to the frame buffer, or 0 on spurious wake / empty FIFO

' Local Variables:
' @local poolStart - Lowest valid frame-pool hub address
' @local poolEnd - Exclusive upper bound of the frame-pool hub region
' @local bHandled - TRUE once the lock has been released by a successful path

  ' Wait for producer to signal data available
  org
    waitatn
  end

  ' Calculate valid frame pool address range for validation
  poolStart := @framePool
  poolEnd := @framePool + (MAX_FRAMES * FRAME_SIZE)

  framePtr := 0
  bHandled := FALSE

  repeat until locktry(lock)
    ' Spin waiting for lock

  case fifoID
    FIFO_HDMI:
      if hdmiCount > 0
        if hdmiHead >= FIFO_DEPTH
          hdmiHead := 0
          hdmiTail := 0
          hdmiCount := 0
          lockrel(lock)
          framePtr := 0
          bHandled := TRUE
        else
          framePtr := LONG[@hdmiFIFO][hdmiHead]
          if framePtr < poolStart or framePtr >= poolEnd
            hdmiHead := (hdmiHead + 1) // FIFO_DEPTH
            hdmiCount--
            lockrel(lock)
            framePtr := 0
            bHandled := TRUE
          else
            hdmiHead := (hdmiHead + 1) // FIFO_DEPTH
            hdmiCount--
            lockrel(lock)
            bHandled := TRUE

    FIFO_OLED:
      if oledCount > 0
        if oledHead >= FIFO_DEPTH
          oledHead := 0
          oledTail := 0
          oledCount := 0
          lockrel(lock)
          framePtr := 0
          bHandled := TRUE
        else
          framePtr := LONG[@oledFIFO][oledHead]
          if framePtr < poolStart or framePtr >= poolEnd
            oledHead := (oledHead + 1) // FIFO_DEPTH
            oledCount--
            lockrel(lock)
            framePtr := 0
            bHandled := TRUE
          else
            oledHead := (oledHead + 1) // FIFO_DEPTH
            oledCount--
            lockrel(lock)
            bHandled := TRUE

    FIFO_SENSOR:
      if sensorCount > 0
        if sensorHead >= FIFO_DEPTH
          sensorHead := 0
          sensorTail := 0
          sensorCount := 0
          lockrel(lock)
          framePtr := 0
          bHandled := TRUE
        else
          framePtr := LONG[@sensorFIFO][sensorHead]
          if framePtr < poolStart or framePtr >= poolEnd
            sensorHead := (sensorHead + 1) // FIFO_DEPTH
            sensorCount--
            lockrel(lock)
            framePtr := 0
            bHandled := TRUE
          else
            sensorHead := (sensorHead + 1) // FIFO_DEPTH
            sensorCount--
            lockrel(lock)
            bHandled := TRUE

  ' FIFO empty (spurious wake or race condition) - release lock only if not yet released
  if not bHandled
    lockrel(lock)
    framePtr := 0

PUB releaseFrame(framePtr) | poolStart, poolEnd
'' Return a frame to the free pool after a consumer is done with it.
''
'' @param framePtr - Hub pointer to the frame buffer

' Local Variables:
' @local poolStart - Lowest valid frame-pool hub address
' @local poolEnd - Exclusive upper bound of the frame-pool hub region

  if framePtr <> 0
    ' Calculate valid frame pool address range for validation
    poolStart := @framePool
    poolEnd := @framePool + (MAX_FRAMES * FRAME_SIZE)

    ' CRITICAL: Validate frame pointer BEFORE acquiring lock
    if framePtr < poolStart or framePtr >= poolEnd
      debug("FIFO FATAL: releaseFrame() ptr=", uhex_long(framePtr), " INVALID! Expected ", uhex_long(poolStart), "-", uhex_long(poolEnd), 13, 10)
    else
      repeat until locktry(lock)
        ' Spin waiting for lock

      if freeCount < MAX_FRAMES
        freeTail := (freeTail + 1) // MAX_FRAMES  ' Move tail first
        ' CRITICAL: Bounds check before array write
        if freeTail >= MAX_FRAMES
          debug("FIFO FATAL: freeTail=", udec(freeTail), " CORRUPTED! Resetting.", 13, 10)
          freeTail := 0
        LONG[@freeList][freeTail] := framePtr       ' Then insert
        freeCount++

      lockrel(lock)

PUB getQueueDepth(fifoID) : count
'' Get the current number of frames in the specified FIFO.
''
'' @param fifoID - Frame FIFO identifier (FIFO_SENSOR/FIFO_HDMI/FIFO_OLED)
'' @returns count - Frame count, or -1 for an invalid FIFO id

  repeat until locktry(lock)
    ' Spin waiting for lock

  case fifoID
    FIFO_SENSOR: count := sensorCount
    FIFO_HDMI:   count := hdmiCount
    FIFO_OLED:   count := oledCount
    other:       count := -1

  lockrel(lock)

PUB getFreeFrames() : count
'' Get the number of available frames in the pool.
''
'' @returns count - Count of free frames in the pool

  repeat until locktry(lock)
    ' Spin waiting for lock

  count := freeCount
  lockrel(lock)

PUB getFreeListAddr() : addr
'' Get the hub address of the freeList array (for debug/watchpoint use).
''
'' @returns addr - Hub pointer to the freeList array

  addr := @freeList

PUB getFramePoolAddr() : addr
'' Get the hub address of the frame pool (for debug/watchpoint use).
''
'' @returns addr - Hub pointer to the frame pool base

  addr := @framePool

PUB checkFreeListIntegrity() : corrupted | i, ptr, poolStart, poolEnd
'' Walk the freeList and report the first entry whose pointer is out of range.
''
'' @returns corrupted - Index of first corrupted entry, or -1 if all entries are valid

' Local Variables:
' @local i - freeList scan index
' @local ptr - Current freeList entry under inspection
' @local poolStart - Lowest valid frame-pool hub address
' @local poolEnd - Exclusive upper bound of the frame-pool hub region

  poolStart := @framePool
  poolEnd := @framePool + (MAX_FRAMES * FRAME_SIZE)

  corrupted := -1  ' Default: all OK
  repeat i from 0 to MAX_FRAMES - 1
    ptr := LONG[@freeList][i]
    if ptr <> 0  ' 0 means slot is empty (already allocated)
      if ptr < poolStart or ptr >= poolEnd
        debug("WATCHPOINT: freeList[", udec(i), "] = ", uhex_long(ptr), " CORRUPTED!", 13, 10)
        corrupted := i
        quit

PRI notifyConsumer(targetCog)
' Send COGATN to wake a specific consumer COG via the Spin2 built-in.
'
' @param targetCog - Cog identifier (0-7) to notify

  ' Use Spin2 built-in COGATN with bitmask (bit N for COG N)
  COGATN(1 << targetCog)