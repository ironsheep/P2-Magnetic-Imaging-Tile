CON ' ---- Test Configuration ----
  _CLKFREQ = 250_000_000
  OLED_BASE_PIN = 16

  ' RGB565 color constants
  COLOR_RED   = $F800
  COLOR_GREEN = $07E0
  COLOR_BLUE  = $001F
  COLOR_WHITE = $FFFF

  ' Test pacing
  ORIENT_SETTLE_MS = 100   ' Pause after orientation change
  CLEAR_HOLD_MS    = 1000  ' Pause after clear-to-black
  COLOR_HOLD_MS    = 2000  ' Pause per solid-color fill
  STATUS_LOOP_MS   = 5000  ' Idle-loop status interval

OBJ ' ---- Subsystem Objects ----
  oled : "isp_oled_driver"

PUB main()
'' Isolation test of the OLED driver that cycles solid colors to confirm display output.
''

  debug("=== OLED SIMPLE TEST ===" , 13, 10)
  debug("Testing OLED driver in isolation", 13, 10)

  ' Initialize OLED driver
  if not oled.start(OLED_BASE_PIN)
    debug("ERROR: OLED init failed!", 13, 10)
  else
    debug("OLED initialized successfully", 13, 10)

    ' Set orientation for hardware setup (ribbon to LEFT)
    debug("Setting orientation to ORIENTATION_270 (ribbon LEFT)...", 13, 10)
    oled.set_orientation(oled.ORIENTATION_270)
    waitms(ORIENT_SETTLE_MS)

    ' Clear to black
    debug("Clearing display to black...", 13, 10)
    oled.clear()
    waitms(CLEAR_HOLD_MS)

    ' Use fill_screen() instead of draw_bitmap() - bypasses streaming COG
    ' RGB565 format: COLOR_RED = red, COLOR_GREEN = green, COLOR_BLUE = blue

    debug("Drawing RED screen...", 13, 10)
    oled.fill_screen(COLOR_RED)
    waitms(COLOR_HOLD_MS)

    debug("Drawing GREEN screen...", 13, 10)
    oled.fill_screen(COLOR_GREEN)
    waitms(COLOR_HOLD_MS)

    debug("Drawing BLUE screen...", 13, 10)
    oled.fill_screen(COLOR_BLUE)
    waitms(COLOR_HOLD_MS)

    debug("Drawing WHITE screen...", 13, 10)
    oled.fill_screen(COLOR_WHITE)
    waitms(COLOR_HOLD_MS)

    debug("OLED test complete - should have seen RED, GREEN, BLUE, WHITE", 13, 10)

    ' Loop with status
    repeat
      waitms(STATUS_LOOP_MS)
      debug("OLED still running...", 13, 10)
