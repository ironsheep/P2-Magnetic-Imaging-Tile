''   Updated.... Oct 2025
''
'' =================================================================================================

CON ' ---- Clock Setup ----
    _clkfreq = 200_000_000

    ' Pins under test (P8..P12 = CS, CCLK, MISO, CLRb, SCLK)
    PIN_CS_ABS    = 8
    PIN_CCLK_ABS  = 9
    PIN_MISO_ABS  = 10
    PIN_CLRB_ABS  = 11
    PIN_SCLK_ABS  = 12

    ' Counter exercise
    COUNTER_MAX        = 31    ' 5-bit counter top value
    REPEAT_PASSES      = 3     ' Number of full 0..COUNTER_MAX sweeps
    STEP_HOLD_MS       = 200   ' Hold per count value
    SMARTPIN_DISABLE_MS = 10   ' Settle pause after disabling smart-pin modes

    ' Per-bit masks for counter-to-pin extraction
    BIT0 = $01
    BIT1 = $02
    BIT2 = $04
    BIT3 = $08
    BIT4 = $10

PUB main() | count, i
'' Drive a binary counter on P8-P12 to identify channels on a logic analyzer.
''

' Local Variables:
' @local count - Counter index sweeping 0..COUNTER_MAX
' @local i - Unused loop placeholder

    debug("================================================================================")
    debug("Binary Counter Test - P8, P9, P10, P11, P12")
    debug("================================================================================")
    debug(" ")
    debug("Pin mapping:")
    debug("  P8  = Bit 0 (LSB) - CS")
    debug("  P9  = Bit 1       - CCLK")
    debug("  P10 = Bit 2       - MISO")
    debug("  P11 = Bit 3       - CLRb")
    debug("  P12 = Bit 4 (MSB) - SCLK")
    debug(" ")

    ' Configure all pins as simple outputs
    pinf(PIN_CS_ABS)         ' Disable smart pin mode
    pinf(PIN_CCLK_ABS)
    pinf(PIN_MISO_ABS)
    pinf(PIN_CLRB_ABS)
    pinf(PIN_SCLK_ABS)

    waitms(SMARTPIN_DISABLE_MS)      ' Small delay after disabling smart pins

    ' Set all low initially - pinh/pinl automatically set direction to output
    pinl(PIN_CS_ABS)
    pinl(PIN_CCLK_ABS)
    pinl(PIN_MISO_ABS)
    pinl(PIN_CLRB_ABS)
    pinl(PIN_SCLK_ABS)

    debug("Starting binary count 0-31, repeating 3 times...")
    debug("Each count held for 200ms")
    debug(" ")

    repeat REPEAT_PASSES
        repeat count from 0 to COUNTER_MAX
            ' Output count as 5-bit binary on P8-P12
            if (count & BIT0)
                pinh(PIN_CS_ABS)
            else
                pinl(PIN_CS_ABS)

            if (count & BIT1)
                pinh(PIN_CCLK_ABS)
            else
                pinl(PIN_CCLK_ABS)

            if (count & BIT2)
                pinh(PIN_MISO_ABS)
            else
                pinl(PIN_MISO_ABS)

            if (count & BIT3)
                pinh(PIN_CLRB_ABS)
            else
                pinl(PIN_CLRB_ABS)

            if (count & BIT4)
                pinh(PIN_SCLK_ABS)
            else
                pinl(PIN_SCLK_ABS)

            waitms(STEP_HOLD_MS)

    ' Set all low at end
    pinl(PIN_CS_ABS)
    pinl(PIN_CCLK_ABS)
    pinl(PIN_MISO_ABS)
    pinl(PIN_CLRB_ABS)
    pinl(PIN_SCLK_ABS)

    debug(" ")
    debug("Counter complete.")
    debug(" ")
    debug("END_SESSION")
