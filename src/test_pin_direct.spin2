CON ' ---- Pin Assignments ----
    _clkfreq = 200_000_000

    TILE_PIN_GROUP = 8
    PIN_MISO = 2

    ' Sampling loop
    SAMPLE_COUNT  = 20      ' Number of MISO reads
    SAMPLE_HOLD_MS = 100    ' Pause between reads

VAR ' ---- Test State ----
    LONG abs_pin_miso

PUB main() | i, pin_state
'' Direct pin read test that samples the raw MISO state without ADC framing.
''

' Local Variables:
' @local i - Sample index
' @local pin_state - Most recent raw pin read

    debug("================================================================================")
    debug("Direct Pin Test - Raw MISO Reading")
    debug("================================================================================")
    debug(" ")

    abs_pin_miso := TILE_PIN_GROUP + PIN_MISO

    debug("MISO pin: P", udec(abs_pin_miso))
    debug(" ")

    ' Configure as simple input
    pinf(abs_pin_miso)

    debug("Reading raw pin state 20 times...")
    debug(" ")

    repeat i from 0 to SAMPLE_COUNT - 1
        pin_state := pinr(abs_pin_miso)
        debug("  Read ", udec_(i), ": ", udec(pin_state))
        waitms(SAMPLE_HOLD_MS)

    debug(" ")
    debug("If pin always reads 1, it's floating high or pulled high")
    debug("If pin always reads 0, it's pulled low or grounded")
    debug("If pin varies, there may be noise or actual signal")
    debug(" ")
    debug("END_SESSION")
