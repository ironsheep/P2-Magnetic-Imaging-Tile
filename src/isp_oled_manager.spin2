'' =================================================================================================
''
''   File....... isp_oled_manager.spin2
''   Purpose.... OLED display manager that consumes frames from the OLED FIFO and drives the OLED hardware
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2025 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2025
''   Updated.... Dec 2025
''
'' =================================================================================================
''
'' This COG:
''   - Dequeues frames from OLED FIFO
''   - Converts sensor data to OLED format
''   - Manages OLED display updates

CON ' ---- OLED Manager Public API ----
  {Spin2_Doc_CON}
  ' Test mode configuration
  TEST_MODE   = false     ' true = show test pattern, false = process FIFO

  ' OLED display dimensions
  OLED_WIDTH  = 128
  OLED_HEIGHT = 128

  ' Sensor display configuration
  SENSOR_GRID_SIZE  = 8
  SENSORS_PER_FRAME = SENSOR_GRID_SIZE * SENSOR_GRID_SIZE  ' 64 cells
  CELL_WIDTH  = OLED_WIDTH / SENSOR_GRID_SIZE    ' 16 pixels per cell
  CELL_HEIGHT = OLED_HEIGHT / SENSOR_GRID_SIZE   ' 16 pixels per cell

  ' Display update modes
  MODE_FULL_UPDATE = 0
  MODE_DIFFERENTIAL = 1

  ' FIFO IDs owned by fifo (isp_frame_fifo_manager) - reference via fifo.fifo.FIFO_OLED

  ' Color mapping ranges
  MIN_FIELD   = 0         ' Minimum field value
  MAX_FIELD   = 4095      ' Maximum field value (12-bit from sensor)
  MID_FIELD   = 2048      ' Neutral field value (12-bit midpoint)

  ' Debug status interval
  STATUS_FRAME_INTERVAL = 60   ' Log status every N frames (~1s @ 60 fps)

  ' Display orientation constants owned by oled (isp_oled_driver)
  ' Reference via oled.ORIENTATION_0, oled.ORIENTATION_90, oled.ORIENTATION_180, oled.ORIENTATION_270

OBJ ' ---- Subsystem Objects ----
  fifo : "isp_frame_fifo_manager"
  oled : "isp_oled_driver"

VAR ' ---- Manager State ----
  long  cog_id
  long  frame_count
  long  update_mode
  long  base_pin
  word  last_frame[SENSORS_PER_FRAME]    ' Previous frame for differential updates
  byte  frame_buffer[OLED_WIDTH * OLED_HEIGHT * 2]  ' OLED display buffer (RGB565)

  ' COG stack (64 longs per P2KB recommendations)
  long  oled_cog_stack[64]

PUB null()
'' Not a top-level object.
''

PUB start(oled_base_pin) : ok
'' Start the OLED manager on the given OLED SPI base pin.
''
'' @param oled_base_pin - Base pin for the OLED SPI interface
'' @returns ok - Cog id (0..7) if successful, -1 if failed

  debug("OLED Manager: Starting...", 13, 10)

  ' Initialize COG ID FIRST (critical - must be set before calling stop()!)
  cog_id := -1

  stop()

  ' Save pin configuration
  base_pin := oled_base_pin

  ' Default: driver failure returns -1
  ok := -1

  ' Initialize OLED driver
  debug("OLED Manager: Calling driver start()...", 13, 10)
  if not oled.start(base_pin)
    debug("OLED Manager: ERROR - Driver start() failed!", 13, 10)
  else
    debug("OLED Manager: Driver initialized successfully", 13, 10)

    ' Clear last frame buffer
    wordfill(@last_frame, 0, SENSORS_PER_FRAME)

    ' Initialize variables
    frame_count := 0
    update_mode := MODE_FULL_UPDATE

    debug("OLED Manager: Starting display COG...", 13, 10)
    ' Start display COG
    cog_id := cogspin(NEWCOG, oled_loop(), @oled_cog_stack)

    if cog_id < 0
      debug("OLED Manager: ERROR - Failed to start COG!", 13, 10)
    else
      debug("OLED Manager: COG ", udec(cog_id), " started successfully", 13, 10)

    ok := cog_id

PUB stop()
'' Stop the OLED manager COG and its driver, clearing the cog id.
''

  ' Validate COG ID is in valid range (0-7) before stopping
  if cog_id >= 0 and cog_id <= 7
    cogstop(cog_id)
    oled.stop()
  cog_id := -1

PUB set_update_mode(mode)
'' Set the display update mode (full or differential).
''
'' @param mode - MODE_FULL_UPDATE or MODE_DIFFERENTIAL

  update_mode := mode

PUB get_frame_count() : count
'' Get the count of frames pushed to the OLED since start.
''
'' @returns count - Frame count

  count := frame_count

PUB set_orientation(new_orientation)
'' Set the display orientation (pass-through to the OLED driver).
''
'' @param new_orientation - One of oled.ORIENTATION_0/90/180/270

  oled.set_orientation(new_orientation)

PUB get_orientation() : current
'' Get the current display orientation (pass-through to the OLED driver).
''
'' @returns current - Current orientation index (0..3)

  current := oled.get_orientation()

PUB show_test_pattern() | row, col, sensorVal, pattern
'' Display a checkerboard test pattern directly, bypassing the FIFO.
''

' Local Variables:
' @local row - Row coordinate within the 8x8 sensor grid
' @local col - Column coordinate within the 8x8 sensor grid
' @local sensorVal - Reserved sensor value (unused)
' @local pattern - Computed gradient pattern value for the current cell

  debug("OLED Test Pattern: Building checkerboard pattern...", 13, 10)

  ' Create a checkerboard pattern with gradient (12-bit values)
  repeat row from 0 to SENSOR_GRID_SIZE - 1
    repeat col from 0 to SENSOR_GRID_SIZE - 1
      ' Create alternating pattern with gradient
      if (row + col) & 1
        pattern := (row * 512) + (col * 256)  ' Diagonal gradient (12-bit)
      else
        pattern := MAX_FIELD - ((row * 512) + (col * 256))  ' Inverse gradient (12-bit)

      ' Build display buffer with test pattern
      build_test_cell(row, col, pattern)

  debug("OLED Test Pattern: Pattern built, clearing display...", 13, 10)
  ' Send to OLED
  oled.clear()

  debug("OLED Test Pattern: Sending bitmap (", udec(OLED_WIDTH * OLED_HEIGHT * 2), " bytes)...", 13, 10)
  oled.draw_bitmap(0, 0, OLED_WIDTH, OLED_HEIGHT, @frame_buffer)

  debug("OLED Test Pattern: Display complete!", 13, 10)

PRI build_test_cell(row, col, sensorVal) | color, x, y, pixelIdx
' Build a single cell in the frame buffer for the test pattern.
'
' @param row - Row coordinate (0..7)
' @param col - Column coordinate (0..7)
' @param sensorVal - Test value to render for this cell

' Local Variables:
' @local color - RGB565 cell color
' @local x - X pixel offset within the cell
' @local y - Y pixel offset within the cell
' @local pixelIdx - Byte index into the frame buffer for this pixel

  ' Convert to RGB565 color
  color := field_to_rgb565(sensorVal)

  ' Fill the cell in display buffer
  repeat y from 0 to CELL_HEIGHT - 1
    repeat x from 0 to CELL_WIDTH - 1
      pixelIdx := ((row * CELL_HEIGHT + y) * OLED_WIDTH + (col * CELL_WIDTH + x)) * 2
      frame_buffer[pixelIdx] := color & $FF
      frame_buffer[pixelIdx + 1] := color >> 8

PRI oled_loop() | framePtr, row, col, sensorVal, color, idx, changed
' Main OLED display loop running in the dedicated OLED manager COG.
'

' Local Variables:
' @local framePtr - Hub pointer to the frame buffer
' @local row - Reserved row index (unused at this level)
' @local col - Reserved col index (unused at this level)
' @local sensorVal - Reserved sensor value (unused at this level)
' @local color - Reserved color value (unused at this level)
' @local idx - Cell index used during change detection
' @local changed - TRUE when current frame differs from the last frame

  debug("OLED Loop: COG started, TEST_MODE=", udec(TEST_MODE), 13, 10)

  if TEST_MODE
    ' Test pattern mode - display once and idle
    debug("OLED Loop: Displaying test pattern...", 13, 10)
    show_test_pattern()
    debug("OLED Loop: Entering idle loop (test pattern should be visible)", 13, 10)
    repeat
      waitms(1000)  ' Just keep COG alive
  else
    ' Normal operation - process FIFO
    debug("OLED Loop: FIFO processing mode active", 13, 10)

    ' Register this COG as OLED FIFO consumer for event-driven wake-ups
    fifo.registerConsumer(fifo.FIFO_OLED, cogid())
    debug("OLED Loop: Registered COG ", udec(cogid()), " for event-driven dequeue", 13, 10)

    ' Clear display initially
    oled.clear()

    repeat
      ' Event-driven dequeue: sleeps until producer sends COGATN
      ' Zero jitter, zero power while waiting
      framePtr := fifo.dequeueEventDriven(fifo.FIFO_OLED)

      if framePtr <> 0
        ' Log first frame received
        if frame_count == 0
          debug("OLED Manager: First frame received! (ptr=", uhex_long(framePtr), ")", 13, 10)

        ' Check if frame has changed (for differential mode)
        changed := false
        if update_mode == MODE_DIFFERENTIAL
          repeat idx from 0 to SENSORS_PER_FRAME - 1
            if word[framePtr][idx] <> last_frame[idx]
              changed := true
              quit

        ' Increment frame counter
        frame_count++

        ' Debug output every STATUS_FRAME_INTERVAL frames (~1 second at 60 fps)
        if (frame_count // STATUS_FRAME_INTERVAL) == 0
          debug("OLED Manager: Processed ", udec(frame_count), " frames", 13, 10)
          debug("  Corner values: TL=", udec(word[framePtr][0]), " TR=", udec(word[framePtr][7]), " BL=", udec(word[framePtr][56]), " BR=", udec(word[framePtr][63]), 13, 10)

        ' Update display if changed or in full update mode
        if changed or (update_mode == MODE_FULL_UPDATE)
          ' Draw sensor data directly using draw_rect() (avoids streaming COG)
          draw_sensor_grid(framePtr)

          ' Save frame for differential comparison
          wordmove(@last_frame, framePtr, SENSORS_PER_FRAME)

        ' Release frame back to pool
        fifo.releaseFrame(framePtr)
      else
        ' FIFO timeout - shouldn't happen in normal operation
        debug("OLED Manager: FIFO dequeue timeout!", 13, 10)
        waitms(10)

PRI draw_sensor_grid(framePtr) | row, col, sensorIdx, sensorVal, color, x_pos, y_pos
' Draw the 8x8 sensor grid directly to the OLED using draw_rect() per cell.
'
' @param framePtr - Hub pointer to the frame buffer

' Local Variables:
' @local row - Row coordinate within the 8x8 sensor grid
' @local col - Column coordinate within the 8x8 sensor grid
' @local sensorIdx - Linear cell index into the frame buffer
' @local sensorVal - Raw sensor reading for the current cell
' @local color - RGB565 cell color
' @local x_pos - X pixel coordinate of the current cell
' @local y_pos - Y pixel coordinate of the current cell

  ' Process each sensor cell and draw directly
  repeat row from 0 to SENSOR_GRID_SIZE - 1
    repeat col from 0 to SENSOR_GRID_SIZE - 1
      ' Get sensor value
      sensorIdx := row * SENSOR_GRID_SIZE + col
      sensorVal := word[framePtr][sensorIdx]

      ' Convert to RGB565 color
      color := field_to_rgb565(sensorVal)

      ' Calculate cell position
      x_pos := col * CELL_WIDTH
      y_pos := row * CELL_HEIGHT

      ' Draw filled rectangle for this cell using Spin2 bit-bang (works!)
      oled.draw_rect(x_pos, y_pos, CELL_WIDTH, CELL_HEIGHT, color)

PRI build_display_buffer(framePtr) | row, col, sensorIdx, sensorVal, color, x, y, pixelIdx
' Legacy frame-to-bitmap converter retained for the test pattern path.
'
' @param framePtr - Hub pointer to the frame buffer

' Local Variables:
' @local row - Row coordinate within the 8x8 sensor grid
' @local col - Column coordinate within the 8x8 sensor grid
' @local sensorIdx - Linear cell index into the frame buffer
' @local sensorVal - Raw sensor reading for the current cell
' @local color - RGB565 cell color
' @local x - X pixel offset within the cell
' @local y - Y pixel offset within the cell
' @local pixelIdx - Byte index into the frame buffer for this pixel

  ' Process each sensor
  repeat row from 0 to SENSOR_GRID_SIZE - 1
    repeat col from 0 to SENSOR_GRID_SIZE - 1
      ' Get sensor value
      sensorIdx := row * SENSOR_GRID_SIZE + col
      sensorVal := word[framePtr][sensorIdx]

      ' Convert to RGB565 color
      color := field_to_rgb565(sensorVal)

      ' Fill the cell in display buffer
      repeat y from 0 to CELL_HEIGHT - 1
        repeat x from 0 to CELL_WIDTH - 1
          pixelIdx := ((row * CELL_HEIGHT + y) * OLED_WIDTH + (col * CELL_WIDTH + x)) * 2
          ' Store RGB565 color (little-endian)
          frame_buffer[pixelIdx] := color & $FF
          frame_buffer[pixelIdx + 1] := color >> 8

PRI field_to_rgb565(fieldVal) : color | redCh, greenCh, blueCh
' Convert a magnetic field value to an RGB565 color (blue->green->red gradient).
'
' @param fieldVal - 12-bit sensor reading (0..4095)
' @returns color - RGB565 color value

' Local Variables:
' @local redCh - Red channel value 0..31
' @local greenCh - Green channel value 0..63
' @local blueCh - Blue channel value 0..31

  ' Color mapping for 12-bit range: Blue (low) -> Green (mid) -> Red (high)
  ' Thresholds: 1024 (1/4), 2048 (mid), 3072 (3/4)

  if fieldVal < 1024  ' Lower quarter - blue dominant
    blueCh := 31
    greenCh := fieldVal >> 4  ' 0-31 range (divide by 32)
    redCh := 0
  elseif fieldVal < 2048  ' Mid-low - cyan to green
    blueCh := 31 - ((fieldVal - 1024) >> 4)
    greenCh := 31
    redCh := 0
  elseif fieldVal < 3072  ' Mid-high - green to yellow
    blueCh := 0
    greenCh := 31
    redCh := (fieldVal - 2048) >> 5  ' 0-31 range (divide by 32)
  else  ' Upper quarter - red dominant
    blueCh := 0
    greenCh := 31 - ((fieldVal - 3072) >> 4)
    redCh := 31

  ' Convert to RGB565 format: RRRRRGGG GGGBBBBB
  color := (redCh << 11) | (greenCh << 6) | blueCh