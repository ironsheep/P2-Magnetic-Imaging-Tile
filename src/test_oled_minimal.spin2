CON ' ---- Clock Setup ----
  _clkfreq = 335_000_000  ' Run at max speed to minimize overhead

  ' Sensor grid (8x8 test frame)
  GRID_SIZE         = 8
  SENSORS_PER_FRAME = GRID_SIZE * GRID_SIZE   ' 64 cells per frame

  ' Test pattern + animation
  GRADIENT_STEP     = 16                                ' Per-cell gradient step
  GRADIENT_MAX      = (SENSORS_PER_FRAME - 1) * GRADIENT_STEP   ' 1008 = top of linear gradient
  PATTERN_INCREMENT = 50                                ' Per-frame drift
  PATTERN_MASK      = $3FF                              ' Wrap pattern to 10 bits
  FRAME_DELAY_MS    = 16                                ' Target ~60 fps (display refresh)

OBJ ' ---- Subsystem Objects ----
  oled : "isp_oled_driver"

VAR ' ---- Test State ----
  long sensor_values[SENSORS_PER_FRAME]

PUB main() | idx, start_time, elapsed_ms
'' Drive the OLED with a drifting gradient pattern to gauge sustainable frame rate.
''

' Local Variables:
' @local idx - Cell index into the 8x8 sensor array
' @local start_time - Reserved timing anchor (unused in current loop)
' @local elapsed_ms - Reserved elapsed-time accumulator (unused in current loop)

  debug("OLED Frame Rate Test", 13, 10)

  if not oled.start(0)
    debug("OLED init failed!", 13, 10)
  else
    debug("OLED initialized at 20 MHz SPI", 13, 10)

    ' Create gradient pattern
    repeat idx from 0 to SENSORS_PER_FRAME - 1
      sensor_values[idx] := idx * GRADIENT_STEP

    debug(13, 10, "Frame rate test (no debug in loop)...", 13, 10)

    ' Continuous animation loop WITHOUT debug output
    repeat
      ' Update all 64 values for smooth color cycling
      repeat idx from 0 to SENSORS_PER_FRAME - 1
        sensor_values[idx] := (sensor_values[idx] + PATTERN_INCREMENT) & PATTERN_MASK

      ' Draw frame with optimized fast method
      oled.draw_grid_8x8_fast(@sensor_values, 0, GRADIENT_MAX)

      ' Wait FRAME_DELAY_MS for 60 fps (display refresh rate)
      waitms(FRAME_DELAY_MS)
