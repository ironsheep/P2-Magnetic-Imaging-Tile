CON ' ---- Pin Mask Setup ----
    _clkfreq = 200_000_000

    PIN_BASE = 8                ' Start at P8
    PIN_COUNT = 5               ' Number of pins under test (P8..P12)
    PIN_MASK = %11111 << PIN_BASE   ' 5 bits starting at PIN_BASE
    PIN_VALUE_MASK = $1F        ' 5-bit value mask written to pins

    ' Counter exercise
    COUNTER_MAX        = 31     ' 5-bit counter top value
    REPEAT_PASSES      = 3      ' Number of full 0..COUNTER_MAX sweeps
    STEP_HOLD_MS       = 200    ' Hold per count value
    INIT_PAUSE_MS      = 100    ' Pause after initial DIR/OUT setup
    SMARTPIN_DISABLE_MS = 10    ' Settle pause after disabling smart-pin modes

PUB main() | count
'' Binary counter on P8-P12 using a pin mask to write all five pins atomically.
''

' Local Variables:
' @local count - Counter index sweeping 0..COUNTER_MAX

    debug("================================================================================")
    debug("Binary Counter Test - Using Pin Masking")
    debug("================================================================================")
    debug(" ")
    debug("Writing 5-bit values to P8-P12 using OUTA register")
    debug("  P8  = Bit 0 (LSB) - CS")
    debug("  P9  = Bit 1       - CCLK")
    debug("  P10 = Bit 2       - MISO")
    debug("  P11 = Bit 3       - CLRb")
    debug("  P12 = Bit 4 (MSB) - SCLK")
    debug(" ")

    ' Disable smart pin modes on all 5 pins
    repeat count from 0 to PIN_COUNT - 1
        pinf(PIN_BASE + count)

    waitms(SMARTPIN_DISABLE_MS)

    ' Set pins P8-P12 as outputs using DIRA register
    DIRA |= PIN_MASK

    ' Set all pins low initially
    OUTA &= !PIN_MASK

    waitms(INIT_PAUSE_MS)

    debug("Starting binary count 0-31, repeating 3 times...")
    debug("Each count held for 200ms")
    debug(" ")

    repeat REPEAT_PASSES
        repeat count from 0 to COUNTER_MAX
            ' Write the count value to pins P8-P12 using OUTA
            ' Clear the 5 bits, then set them to count value
            OUTA := (OUTA & !PIN_MASK) | ((count & PIN_VALUE_MASK) << PIN_BASE)

            waitms(STEP_HOLD_MS)

    ' Set all low at end
    OUTA &= !PIN_MASK

    debug(" ")
    debug("Counter complete using pin masking.")
    debug(" ")
    debug("END_SESSION")
