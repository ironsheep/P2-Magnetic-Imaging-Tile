''   Updated.... Nov 2025
''
'' =================================================================================================

CON ' ---- Test Configuration ----
  _CLKFREQ = 250_000_000
  HDMI_BASE_PIN = 0
  SCREEN_WIDTH = 640
  SCREEN_HEIGHT = 480

  ' RGBA color constants (RRGGBBAA)
  COLOR_RED   = $FF0000FF
  COLOR_GREEN = $00FF00FF

  ' PSRAM mailbox + pacing
  PSRAM_MBOX_STRIDE      = 12     ' Bytes per PSRAM mailbox entry
  PROGRESS_LINE_INTERVAL = 60     ' Log every Nth scanline
  STARTUP_SETTLE_MS      = 100    ' Pause after HDMI start
  COLOR_HOLD_MS          = 2000   ' Pause between fills
  STATUS_LOOP_MS         = 5000   ' Idle-loop status interval

OBJ ' ---- Subsystem Objects ----
  psram : "PSRAM_driver_RJA_Platform_1b"
  hdmi  : "isp_hdmi_640x480_24bpp"

VAR ' ---- Test State ----
  LONG psram_cmd_ptr
  LONG screen_base
  LONG row[SCREEN_WIDTH]

PUB main()
'' HDMI sanity test using a simple fill pattern via the isp_psram_graphics approach.
''

  debug("=== HDMI SIMPLE FILL TEST ===", 13, 10)

  '' Start PSRAM
  psram.start()
  debug("PSRAM started", 13, 10)

  '' Start HDMI FIRST (like isp_psram_graphics does)
  screen_base := 0
  hdmi.start(HDMI_BASE_PIN, psram.pointer(), screen_base)
  debug("HDMI started", 13, 10)

  '' Get our per-cog command pointer for writing
  psram_cmd_ptr := psram.pointer() + cogid() * PSRAM_MBOX_STRIDE

  '' Wait a moment
  waitms(STARTUP_SETTLE_MS)

  '' Now fill screen with solid red (like cls does)
  debug("Filling screen with red...", 13, 10)
  fillScreen(COLOR_RED)
  debug("Fill complete", 13, 10)

  '' Wait and then fill with green
  waitms(COLOR_HOLD_MS)
  debug("Filling screen with green...", 13, 10)
  fillScreen(COLOR_GREEN)
  debug("Fill complete", 13, 10)

  '' Main loop
  repeat
    waitms(STATUS_LOOP_MS)
    debug("Running...", 13, 10)

PRI fillScreen(color) | y
' Fill every scanline of the PSRAM framebuffer with a single RRGGBBAA color.
'
' @param color - RRGGBBAA pixel color to flood the screen with

' Local Variables:
' @local y - Scanline index 0..SCREEN_HEIGHT-1

  '' Fill row buffer with color
  longfill(@row[0], color, SCREEN_WIDTH)

  '' Write row to each line of screen
  repeat y from 0 to SCREEN_HEIGHT-1
    LONG[psram_cmd_ptr][0] := @row[0]               ' HUB source
    LONG[psram_cmd_ptr][1] := y * SCREEN_WIDTH      ' PSRAM destination
    LONG[psram_cmd_ptr][2] := -SCREEN_WIDTH         ' Negative = write
    repeat while LONG[psram_cmd_ptr][2]             ' Wait for completion

    if (y // PROGRESS_LINE_INTERVAL) == 0
      debug("Line ", UDEC(y), 13, 10)
