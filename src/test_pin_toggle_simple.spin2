CON ' ---- Pin Mask Setup ----
    _clkfreq = 200_000_000

    PIN_BASE = 8
    PIN_COUNT = 5                   ' Number of pins under test (P8..P12)
    PIN_MASK = %11111 << PIN_BASE   ' P8-P12

    INIT_PAUSE_MS  = 100            ' Pause after initial DIR/OUT setup
    TOGGLE_HOLD_US = 500            ' Half-period (500us = ~1kHz toggle)

PUB main() | i
'' Continuous simple toggle of pins P8-P12 for scope/logic-analyzer verification.
''

' Local Variables:
' @local i - Pin-index loop counter

    debug("================================================================================")
    debug("Simple Pin Toggle Test - P8-P12")
    debug("================================================================================")
    debug(" ")

    ' Disable smart pin modes on all 5 pins (do this ONCE)
    repeat i from 0 to PIN_COUNT - 1
        pinf(PIN_BASE + i)

    'waitms(10)

    ' Set all pins as OUTPUTS using DIRA (do this ONCE)
    DIRA |= PIN_MASK

    ' Set all pins low initially
    OUTA &= !PIN_MASK

    waitms(INIT_PAUSE_MS)

    debug("Toggling P8-P12 continuously...")
    debug("  P8  = CS")
    debug("  P9  = CCLK")
    debug("  P10 = MISO")
    debug("  P11 = CLRb")
    debug("  P12 = SCLK")
    debug(" ")
    debug("Toggling at ~1kHz (500us per toggle)")
    debug(" ")

    ' Just toggle forever - do NOT reset direction
    repeat
        ' Toggle all 5 pins at once
        OUTA ^= PIN_MASK
        waitus(TOGGLE_HOLD_US)
