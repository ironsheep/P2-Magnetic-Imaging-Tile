'' =================================================================================================
''
''   File....... test_pin_binary.spin2
''   Purpose.... Drive a binary counter on the tile pins to identify which physical wire is which
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2025 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Jan 2025
''   Updated.... Oct 2025
''
'' =================================================================================================

CON ' ---- Pin Assignments ----
    _clkfreq = 200_000_000

    TILE_PIN_GROUP = 8

    ' Pin offsets within group
    PIN_CS = 0      ' Bit 0 of counter
    PIN_CCLK = 1    ' Bit 1 of counter
    PIN_MISO = 2    ' Bit 2 of counter (normally input, but we'll drive it for this test)
    PIN_CLRb = 3    ' Bit 3 of counter
    PIN_SCLK = 4    ' Bit 4 of counter

    ' Counter exercise
    COUNTER_MAX     = 31     ' 5-bit counter top value
    REPEAT_PASSES   = 3      ' Number of full 0..COUNTER_MAX sweeps
    STEP_HOLD_MS    = 200    ' Hold per count value
    PULSE_HOLD_MS   = 1000   ' Initial CS-high/low identification pulse

    ' Per-bit masks for counter-to-pin extraction
    BIT0 = $01
    BIT1 = $02
    BIT2 = $04
    BIT3 = $08
    BIT4 = $10

VAR ' ---- Test State ----
    LONG abs_pin_cs
    LONG abs_pin_cclk
    LONG abs_pin_miso
    LONG abs_pin_clrb
    LONG abs_pin_sclk

PUB main() | count
'' Drive a binary counter on the tile pins to identify which physical wire is which.
''

' Local Variables:
' @local count - Counter index sweeping 0..COUNTER_MAX

    debug("================================================================================")
    debug("Binary Counter Test - Identify Physical Pins")
    debug("================================================================================")
    debug(" ")

    ' Calculate absolute pin numbers
    abs_pin_cs := TILE_PIN_GROUP + PIN_CS
    abs_pin_cclk := TILE_PIN_GROUP + PIN_CCLK
    abs_pin_miso := TILE_PIN_GROUP + PIN_MISO
    abs_pin_clrb := TILE_PIN_GROUP + PIN_CLRb
    abs_pin_sclk := TILE_PIN_GROUP + PIN_SCLK

    debug("Pin assignments (bit positions in counter):")
    debug("  P", udec(abs_pin_cs), " (CS)   = Bit 0 (LSB)")
    debug("  P", udec(abs_pin_cclk), " (CCLK) = Bit 1")
    debug("  P", udec(abs_pin_miso), " (MISO) = Bit 2")
    debug("  P", udec(abs_pin_clrb), " (CLRb) = Bit 3")
    debug("  P", udec(abs_pin_sclk), " (SCLK) = Bit 4 (MSB)")
    debug(" ")

    ' Configure all pins as simple outputs
    pinf(abs_pin_cs)
    pinf(abs_pin_cclk)
    pinf(abs_pin_miso)
    pinf(abs_pin_clrb)
    pinf(abs_pin_sclk)

    ' Force CS high initially to see if it can be driven
    debug("Setting CS (P", udec(abs_pin_cs), ") HIGH for 1 second...")
    pinh(abs_pin_cs)
    pinl(abs_pin_cclk)
    pinl(abs_pin_miso)
    pinl(abs_pin_clrb)
    pinl(abs_pin_sclk)
    waitms(PULSE_HOLD_MS)

    debug("Setting CS LOW for 1 second...")
    pinl(abs_pin_cs)
    waitms(PULSE_HOLD_MS)

    debug(" ")
    debug("Starting binary counter 0-31, repeating 3 times...")
    debug("Each count held for 200ms")
    debug(" ")

    repeat REPEAT_PASSES
        repeat count from 0 to COUNTER_MAX
            ' Output count as 5-bit binary
            if (count & BIT0)
                pinh(abs_pin_cs)
            else
                pinl(abs_pin_cs)

            if (count & BIT1)
                pinh(abs_pin_cclk)
            else
                pinl(abs_pin_cclk)

            if (count & BIT2)
                pinh(abs_pin_miso)
            else
                pinl(abs_pin_miso)

            if (count & BIT3)
                pinh(abs_pin_clrb)
            else
                pinl(abs_pin_clrb)

            if (count & BIT4)
                pinh(abs_pin_sclk)
            else
                pinl(abs_pin_sclk)

            waitms(STEP_HOLD_MS)

    ' Set all low at end
    pinl(abs_pin_cs)
    pinl(abs_pin_cclk)
    pinl(abs_pin_miso)
    pinl(abs_pin_clrb)
    pinl(abs_pin_sclk)

    debug(" ")
    debug("Counter complete. Pin identification:")
    debug("  Fastest toggle (every 200ms):   Bit 0 = P", udec(abs_pin_cs), " (CS)")
    debug("  2nd fastest (every 400ms):      Bit 1 = P", udec(abs_pin_cclk), " (CCLK)")
    debug("  3rd fastest (every 800ms):      Bit 2 = P", udec(abs_pin_miso), " (MISO)")
    debug("  4th fastest (every 1.6s):       Bit 3 = P", udec(abs_pin_clrb), " (CLRb)")
    debug("  Slowest toggle (every 3.2s):    Bit 4 = P", udec(abs_pin_sclk), " (SCLK)")
    debug(" ")
    debug("END_SESSION")
